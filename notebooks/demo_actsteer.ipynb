    "llm = HookLLM(\n",
    "    model=model,\n",
    "    worker_name=\"steer_hook_act\",\n",
    "    config_file=json_path,\n",
    "    download_dir=cache_dir,\n",
    "    gpu_memory_utilization=0.7,\n",
    "    trust_remote_code=True,\n",
    "    dtype=dtype_map[model],\n",
    "    enable_prefix_caching=True,\n",
