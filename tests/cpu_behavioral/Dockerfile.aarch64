FROM python:3.12-bookworm

ARG VLLM_REF=v0.29.0
ARG TRITON_CPU_REF=main
ARG BUILD_JOBS=2

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV MAX_JOBS=${BUILD_JOBS}
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}
ENV MAKEFLAGS="-j${BUILD_JOBS}"
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV TRITON_DEFAULT_BACKEND=cpu
ENV TRITON_CACHE_DIR=/tmp/triton-cache
ENV MIA_WRITER_PROCESS=0
ENV VLLM_RPC_TIMEOUT=300

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libomp-dev \
    ninja-build \
    pkg-config \
    rustc \
    cargo \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv "${VIRTUAL_ENV}" \
    && python -m pip install --upgrade pip uv setuptools wheel cmake ninja pytest ipykernel \
    && python -m pip install setuptools-rust setuptools-scm zstandard

WORKDIR /opt/src

RUN git clone https://github.com/triton-lang/triton-cpu.git \
    && cd triton-cpu \
    && git checkout "${TRITON_CPU_REF}" \
    && python -m pip install \
        -r python/requirements.txt \
        -r python/test-requirements.txt \
        -r python/tutorials/requirements.txt \
    && MAX_JOBS="${BUILD_JOBS}" CMAKE_BUILD_PARALLEL_LEVEL="${BUILD_JOBS}" \
        python -m pip install -e . --no-build-isolation

RUN git clone --branch "${VLLM_REF}" --depth 1 https://github.com/vllm-project/vllm.git \
    && cd vllm \
    && uv pip install -r requirements/cpu.txt \
    && MAX_JOBS="${BUILD_JOBS}" CMAKE_BUILD_PARALLEL_LEVEL="${BUILD_JOBS}" \
        uv pip install -e . --no-build-isolation

WORKDIR /workspace/vllm-hook

COPY . /workspace/vllm-hook

RUN python -m pip install -e . --no-deps

CMD ["python", "tests/cpu_behavioral/run_hidden_states_cpu.py"]
